	// GVL PERSISTENT VARS
// PARAMETROS RETENTIVOS

// USAR PREFIXO "P_" PARA IDENTIFICACAO NO PROGRAMA AO CRIAR NOVAS VARIAVEIS

// VALORES INICIAIS DEFINIDOS NAS VARIAVEIS SAO CARREGADOS APENAS NO 1º DOWNLOAD OU SE INICIALIZAR AS VARIAVEIS PERSISTENTES 

		
	//parametros de ajuste do controle de temperatura
	//estrutura ST_PID:
	//Kp ganho proporcional (0...10000)
	//Tn tempo integral (0...60000)
	//Tv tempo derivada (0...60000)
	//Td damping time derivada  (min tempo de ciclo da tarefa...60000) 
	{warning 'Definir valores iniciais dos parametros de PID de controle de temperatura - a serem ajustados apos autotune'}
	P_stPid1		: SE_CTBX.ST_PID := (rKp := 2.0, rTn := 200.0);	//IHM parametro - parametros PID 1
	P_stPid2		: SE_CTBX.ST_PID := (rKp := 2.0, rTn := 200.0);	//IHM parametro - parametros PID 2
