      <Single Name="TextBlobForSerialisation" Type="string">FUNCTION_BLOCK SetDateAndTime
VAR_INPUT
	/// seta novo horário na transição false para true
	i_xSetDateTime: BOOL;
	///Valor para o ano a ser ajustado
	i_UIntYear: UINT := 2011;
	///Valor para o mes a ser ajustado
	i_UIntMonth: UINT := 1;
	///Valor para o dia a ser ajustado
	i_UIntDay: UINT := 1;
	///Valor para a hora a ser ajustada
	i_UIntHour: UINT := 0;
	///Valor para o minuto a ser ajustado
	i_UIntMinute: UINT := 0;
	///Valor para o segundo a ser ajustado
	i_UIntSecond: UINT := 0;
END_VAR
VAR_OUTPUT
	///Status quando se =0 ok se &lt;&gt;0 erro nas informações de entrada
	q_UIntDatetoUTC_diag: UDINT;
	///Status quando se =0 ok se &lt;&gt;0 erro nas informações de entrada
	q_UIntRtcSet_diag: UDINT;
END_VAR
VAR
	My_UTC: DWORD;
	MyDateTime: SYSTIMEDATE;
	milesec: UINT := 0;
	dayOfWeek: UINT := 1;
	yday: UINT := 1;
END_VAR
</Single>
